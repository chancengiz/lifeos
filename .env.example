# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=lifeos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lifeos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# LLM providers (SPEC 10). Which tier uses which is set in config/llm_tiers.yaml.
ANTHROPIC_API_KEY=
# Only needed for tiers routed through the litellm backend (TIER_EMBED today).
OPENAI_API_KEY=

# At-rest encryption (SPEC 12). Fernet key, base64 32 bytes.
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
FERNET_KEY_VERSION=1
